<Project Sdk="Microsoft.NET.Sdk">
  <!-- StreamLite for Linux: the same noise removal, 3D audio and headphone EQ code as the Windows app (../src),
       with a PipeWire / PulseAudio audio layer and an Avalonia interface. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <AssemblyName>streamlite</AssemblyName>
    <RootNamespace>StreamLite</RootNamespace>
    <Version>3.5.8</Version>
    <Product>StreamLite</Product>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <DefineConstants>$(DefineConstants);LINUX</DefineConstants>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS0649;CS0169;CS0414;CA1416;SYSLIB0014;CS8981</NoWarn>
    <ApplicationIcon />
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="**\*.cs" Exclude="bin\**;obj\**" />
    <!-- Shared with Windows -->
    <Compile Include="..\src\Audio\Dsp.cs;..\src\Audio\Rnnoise.cs;..\src\Audio\RnnoiseModel.cs;..\src\Audio\DeepFilter.cs;..\src\Audio\Onnx.cs" LinkBase="Shared" />
    <Compile Include="..\src\Audio\VoiceChain.cs;..\src\Audio\Spatial.cs;..\src\Audio\Spatial360.cs;..\src\Audio\Hrtf.cs;..\src\Audio\SoundCube.cs;..\src\Audio\AutoEq.cs;..\src\Audio\Rings.cs;..\src\Audio\InputChannels.cs;..\src\Audio\RealtimeNs.cs;..\src\Audio\NoisePrint.cs;..\src\Audio\StudioVoice.cs;..\src\Audio\VoiceLock.cs" LinkBase="Shared" />
    <Compile Include="..\src\NoiseEngines.cs;..\src\GamePresets.cs;..\src\GameProfiles.cs;..\src\Settings.cs;..\src\Updater.cs;..\src\Credits.cs;..\src\HardwareTuning.cs;..\src\AiTiers.cs" LinkBase="Shared" />
    <EmbeddedResource Include="..\res\hrtf_kemar.bin" LogicalName="hrtf_kemar.bin" />
    <EmbeddedResource Include="..\res\hrtf_ku100.bin" LogicalName="hrtf_ku100.bin" />
    <EmbeddedResource Include="..\res\SADIE-LICENSE.txt" LogicalName="SADIE-LICENSE.txt" />
    <EmbeddedResource Include="..\THIRD-PARTY-NOTICES.md" LogicalName="THIRD-PARTY-NOTICES.md" />
    <EmbeddedResource Include="streamlite.png" LogicalName="streamlite.png" />
    <None Include="..\ai\deepfilternet3.onnx;..\ai\DEEPFILTERNET-NOTICE.txt;..\ai\ONNXRUNTIME-LICENSE.txt" Link="ai\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\hrtf\*.blh" Link="hrtf\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Headless" Version="11.2.3" />
    <PackageReference Include="Avalonia.Skia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.3" />
    <!-- Only the native libonnxruntime.so is used (through its C API, like on Windows). -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.24.4" ExcludeAssets="compile;build;buildTransitive" GeneratePathProperty="true" />
  </ItemGroup>

  <Target Name="CopyOrt" AfterTargets="Build;Publish">
    <Copy SourceFiles="$(PkgMicrosoft_ML_OnnxRuntime)\runtimes\linux-x64\native\libonnxruntime.so" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Copy Condition="'$(PublishDir)' != ''" SourceFiles="$(PkgMicrosoft_ML_OnnxRuntime)\runtimes\linux-x64\native\libonnxruntime.so" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
