# Maintainer: NermalYT <96622161+NermalYT@users.noreply.github.com>
# StreamLite for Arch Linux and friends (Manjaro, EndeavourOS, CachyOS, Garuda).
# Install: download this file into an empty folder, then run  makepkg -si
pkgname=streamlite-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc="Clean mic (AI noise removal), 3D game audio and headphone EQ for PipeWire / PulseAudio"
arch=('x86_64')
url="https://github.com/NermalYT/StreamLite"
license=('GPL-3.0-or-later')
depends=('libpulse' 'fontconfig' 'libx11' 'libice' 'libsm' 'openssl' 'zlib' 'gcc-libs' 'glibc')
optdepends=('libnotify: desktop notifications for updates' 'pipewire-pulse: if you use PipeWire')
provides=('streamlite')
conflicts=('streamlite')
options=('!strip' '!debug')
source=("https://github.com/NermalYT/StreamLite/releases/download/v${pkgver}/streamlite-${pkgver}-linux-x64.tar.gz")
sha256sums=('@SHA256@')

package() {
    cd "streamlite-${pkgver}"
    install -d "${pkgdir}/opt/streamlite/ai" "${pkgdir}/usr/bin"
    install -m755 streamlite "${pkgdir}/opt/streamlite/streamlite"
    install -m644 ./*.so "${pkgdir}/opt/streamlite/"
    install -m644 ai/* "${pkgdir}/opt/streamlite/ai/"
    echo arch > "${pkgdir}/opt/streamlite/install-kind.txt"
    ln -s /opt/streamlite/streamlite "${pkgdir}/usr/bin/streamlite"
    install -Dm644 streamlite.desktop "${pkgdir}/usr/share/applications/streamlite.desktop"
    install -Dm644 streamlite.png "${pkgdir}/usr/share/icons/hicolor/256x256/apps/streamlite.png"
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    install -Dm644 THIRD-PARTY-NOTICES.md "${pkgdir}/usr/share/licenses/${pkgname}/THIRD-PARTY-NOTICES.md"
}
