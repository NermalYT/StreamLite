<!-- StreamLite MSI (WiX Toolset 5). Built by packaging\windows\build-msi.ps1 from the staged "payload" folder. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="StreamLite" Manufacturer="StreamLite" Version="$(Version)" Language="1033"
           UpgradeCode="93E97AB9-42DB-492D-AB7E-F7B7DFA5E16B" Scope="perMachine" Compressed="yes" InstallerVersion="500">
    <SummaryInformation Description="StreamLite - clean mic, 3D game audio, headphone EQ and AI camera" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of StreamLite is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="StreamLiteIcon" SourceFile="payload\app.ico" />
    <Property Id="ARPPRODUCTICON" Value="StreamLiteIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/NermalYT/StreamLite" />
    <Property Id="ARPHELPLINK" Value="https://nermalyt.github.io/StreamLite/" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="StreamLite" />
    </StandardDirectory>

    <Feature Id="Main" Title="StreamLite" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
      <ComponentRef Id="FreshInstallMark" />
    </Feature>

    <!-- A new install, not an update (4.2.1): StreamLite's first start on each account sets the settings there aside
         and runs the whole setup (Scan for settings brings back the parts you pick). An upgrade leaves this out - and
         removes an older install's mark. KEEPSETTINGS=1 (StreamLite's updater) leaves it out too. -->
    <Component Id="FreshInstallMark" Directory="INSTALLFOLDER" Condition="NOT WIX_UPGRADE_DETECTED AND NOT KEEPSETTINGS">
      <RegistryValue Root="HKLM" Key="Software\StreamLite" Name="FreshInstall" Type="string" Value="[Date] [Time]" KeyPath="yes" />
    </Component>

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Component Id="MainExe">
        <File Id="StreamLiteExe" Source="payload\StreamLite.exe" KeyPath="yes" />
      </Component>
      <Files Include="payload\**">
        <Exclude Files="payload\StreamLite.exe" />
      </Files>
    </ComponentGroup>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut">
        <Shortcut Id="StartMenuSc" Name="StreamLite" Description="Clean mic, 3D game audio, headphone EQ and AI camera"
                  Target="[INSTALLFOLDER]StreamLite.exe" WorkingDirectory="INSTALLFOLDER" Icon="StreamLiteIcon" />
        <RegistryValue Root="HKCU" Key="Software\StreamLite" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut">
        <Shortcut Id="DesktopSc" Name="StreamLite" Description="Clean mic, 3D game audio, headphone EQ and AI camera"
                  Target="[INSTALLFOLDER]StreamLite.exe" WorkingDirectory="INSTALLFOLDER" Icon="StreamLiteIcon" />
        <RegistryValue Root="HKCU" Key="Software\StreamLite" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <!-- Close a running StreamLite before files are replaced or removed. -->
    <util:CloseApplication Id="CloseStreamLite" Target="StreamLite.exe" TerminateProcess="0" RebootPrompt="no" />

    <!-- Uninstall: StreamLite puts your sound devices back the way Windows had them (names, switched-off cable
         endpoints, default devices, Equalizer APO entry, virtual camera), then the MSI removes the files. -->
    <!-- [UILevel] 2 = msiexec /qn: StreamLite asks nothing. What it installed goes either way, what was here before stays. -->
    <CustomAction Id="RestoreDevices" FileRef="StreamLiteExe" ExeCommand="--uninstall --confirmed --from-msi --msi-ui=[UILevel]"
                  Execute="immediate" Return="ignore" Impersonate="yes" />
    <!-- If that step's permission prompt was refused, this one needs none and removes what StreamLite installed. -->
    <CustomAction Id="RemoveWhatWasLeft" FileRef="StreamLiteExe" ExeCommand="--uninstall --confirmed --from-msi --msi-system"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <!-- Install / upgrade: everything StreamLite needs, inside this one installer window and without more prompts -
         VB-CABLE, VB-Audio Hi-Fi Cable and Equalizer APO, each downloaded from its maker and installed silently (what's
         already there is skipped). Runs elevated with the installer; never fails the install (the app offers anything
         that didn't work). Log: %ProgramData%\StreamLite\prerequisites.log. SKIPPREREQUISITES=1 leaves them out. -->
    <CustomAction Id="InstallPrerequisites" FileRef="StreamLiteExe" ExeCommand="--install-prerequisites"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="RestoreDevices" Before="InstallValidate" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="RemoveWhatWasLeft" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="InstallPrerequisites" After="InstallFiles" Condition="NOT REMOVE AND NOT SKIPPREREQUISITES" />
    </InstallExecuteSequence>
    <UI>
      <ProgressText Action="InstallPrerequisites" Message="Installing VB-CABLE, Hi-Fi Cable and Equalizer APO (downloaded from their makers)..." />
    </UI>

    <!-- Wizard: license, install, then optionally start StreamLite. -->
    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Start StreamLite now" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#StreamLiteExe]" />
    <CustomAction Id="LaunchStreamLite" DllEntry="WixShellExec" Impersonate="yes" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" />
    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchStreamLite"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
    </UI>
  </Package>
</Wix>
